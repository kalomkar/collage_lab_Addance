# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# PORT: Port to bind (defaults to 3000)
PORT=3000

# ----------------------------------------------------
# SMTP Mail Server Configuration (Nodemailer)
# ----------------------------------------------------
# Host of your mail server (e.g. smtp.gmail.com, smtp.office365.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# Port: 587 for STARTTLS, 465 for SSL/TLS
SMTP_PORT=587

# SMTP Account Username or Email address
SMTP_USERNAME=your-email@gmail.com

# SMTP Password or Gmail 16-character App Password (recommended)
SMTP_PASSWORD=your-app-password

# Optional: Custom From/Sender email address
SMTP_SENDER_EMAIL=your-email@gmail.com

# ----------------------------------------------------
# College Recipient Configuration
# ----------------------------------------------------
# Default recipient email address for Principal / Management daily reports
PRINCIPAL_EMAIL=principal@college.edu
