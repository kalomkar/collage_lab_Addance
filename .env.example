NODE_ENV=production
PORT=3000

# Keep-Alive URL for Render 24/7 Uptime (e.g. https://your-app.onrender.com)
SERVER_URL=

# Principal Recipient Email
PRINCIPAL_EMAIL=principal@college.edu

# SMTP Mail Server Configuration (Port 465 recommended for Render)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-college-email@gmail.com
SMTP_PASSWORD=your-16-digit-google-app-password
SMTP_SENDER_EMAIL=your-college-email@gmail.com

# (Optional) Resend API Key for 100% cloud delivery without SMTP ports
RESEND_API_KEY=
